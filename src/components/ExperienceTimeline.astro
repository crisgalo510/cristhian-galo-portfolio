---
import { getCollection, render } from 'astro:content';

const rawEntries = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order
);

const entries = await Promise.all(
  rawEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { data: entry.data, Content };
  })
);
---

<section class="px-6 py-20">
  <div class="max-w-2xl mx-auto w-full">
    <h1 class="text-xl font-semibold text-text mb-10">Experience</h1>

    <ol class="relative border-l border-border pl-6 space-y-6">
      {entries.map(({ data, Content }) => (
        <li class="relative">
          <span
            class="absolute -left-[29px] top-6 w-2.5 h-2.5 rounded-full bg-accent"
            aria-hidden="true"
          ></span>
          <div class="rounded-xl border border-border bg-surface p-5">
            {(data.image || data.imagePending) && (
              <div class="aspect-video w-full max-w-xs rounded-lg overflow-hidden border border-border bg-bg mb-4">
                {data.image ? (
                  <img src={data.image} alt={`${data.role} at ${data.org}`} class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center gap-1 text-text-dim text-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 opacity-70" aria-hidden="true">
                      <path d="M4.5 5.25A2.25 2.25 0 016.75 3h10.5a2.25 2.25 0 012.25 2.25v13.5a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25V5.25zm4.5 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3zm-2.033 9.75h11.066l-3.694-4.928a.75.75 0 00-1.174-.05l-2.63 3.007-1.4-1.4a.75.75 0 00-1.115.06l-3.053 3.311z" />
                    </svg>
                    <span>Photo coming soon</span>
                  </div>
                )}
              </div>
            )}
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-text font-medium">{data.role}</h3>
              <span class="text-xs text-text-dim font-mono whitespace-nowrap">
                {data.startDate} - {data.endDate}
              </span>
            </div>
            <p class="text-sm text-text-dim">
              {data.org}{data.location ? `, ${data.location}` : ''}
            </p>
            <div class="text-sm text-text mt-2 max-w-[65ch]">
              <Content />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
