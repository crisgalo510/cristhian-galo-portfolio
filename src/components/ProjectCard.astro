---
interface Props {
  title: string;
  description: string;
  stack: string[];
  featured?: boolean;
  repo?: string;
  demo?: string;
  githubRepo?: string;
  image?: string;
  imagePending?: boolean;
}

const { title, description, stack, featured = false, repo, demo, githubRepo, image, imagePending = false } = Astro.props;
---

<article
  class:list={[
    'rounded-lg border border-border bg-surface p-6 flex flex-col gap-3',
    featured ? 'sm:col-span-2' : '',
  ]}
>
  {(image || imagePending) && (
    <div class="aspect-video w-full rounded-lg overflow-hidden border border-border bg-bg -mt-1">
      {image ? (
        <img src={image} alt={`${title} screenshot`} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center gap-1 text-text-dim text-xs">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 opacity-70" aria-hidden="true">
            <path d="M4.5 5.25A2.25 2.25 0 016.75 3h10.5a2.25 2.25 0 012.25 2.25v13.5a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25V5.25zm4.5 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3zm-2.033 9.75h11.066l-3.694-4.928a.75.75 0 00-1.174-.05l-2.63 3.007-1.4-1.4a.75.75 0 00-1.115.06l-3.053 3.311z" />
          </svg>
          <span>Photo coming soon</span>
        </div>
      )}
    </div>
  )}

  <div class="flex items-start justify-between gap-4">
    <h3 class="text-text font-medium">{title}</h3>
    {githubRepo && (
      <div class="github-stats flex items-center gap-1 text-xs text-text-dim font-mono shrink-0" data-repo={githubRepo}>
        <span class="stat-stars skeleton inline-block w-10 h-4"></span>
      </div>
    )}
  </div>

  <p class="text-sm text-text-dim leading-relaxed">{description}</p>

  <ul class="flex flex-wrap gap-2 mt-1" aria-label="Tech stack">
    {stack.map((tech) => (
      <li class="text-xs font-mono text-accent border border-accent-dim/40 rounded px-2 py-0.5">
        {tech}
      </li>
    ))}
  </ul>

  {(repo || demo) && (
    <div class="flex gap-4 mt-2 text-sm">
      {repo && (
        <a href={repo} class="inline-block py-2 -my-2 text-text-dim hover:text-accent underline decoration-dotted" target="_blank" rel="noopener noreferrer">
          repo
        </a>
      )}
      {demo && (
        <a href={demo} class="inline-block py-2 -my-2 text-text-dim hover:text-accent underline decoration-dotted" target="_blank" rel="noopener noreferrer">
          demo
        </a>
      )}
    </div>
  )}
</article>

<script>
  // Fetch live star counts for any card that declared a githubRepo.
  // Runs once per page load across all cards.
  async function loadGithubStats() {
    const els = document.querySelectorAll<HTMLElement>('.github-stats[data-repo]');
    await Promise.all(
      Array.from(els).map(async (el) => {
        const repo = el.dataset.repo;
        const starEl = el.querySelector('.stat-stars');
        if (!repo || !starEl) return;
        try {
          const res = await fetch(`https://api.github.com/repos/${repo}`);
          if (!res.ok) throw new Error('not found');
          const data = await res.json();
          starEl.textContent = `★ ${data.stargazers_count}`;
          starEl.classList.remove('skeleton', 'w-10', 'h-4');
        } catch {
          // fail quietly — just hide the stat rather than showing an error in a card
          el.remove();
        }
      })
    );
  }
  loadGithubStats();
</script>
