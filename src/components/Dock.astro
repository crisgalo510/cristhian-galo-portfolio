---

<div id="dock-wrap" class="fixed right-4 top-1/2 -translate-y-1/2 z-20">
  <nav
    id="dock"
    aria-label="Quick links"
    class="dock-anim flex flex-col items-center gap-4 rounded-2xl border border-border bg-surface/90 backdrop-blur px-3 py-4 shadow-xl"
  >
    {items.map((item) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        aria-label={item.label}
        title={item.label}
        class:list={[
          'dock-icon flex items-center justify-center w-12 h-12 rounded-xl text-white shadow-md will-change-transform',
          item.bg,
        ]}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true">
          {item.paths.map((d) => <path d={d} />)}
        </svg>
      </a>
    ))}
  </nav>
</div>

<style>
  @keyframes dock-enter {
    0% {
      transform: translateX(44px);
      opacity: 0;
    }
    55% {
      transform: translateX(-8px);
      opacity: 1;
    }
    75% {
      transform: translateX(3px);
    }
    100% {
      transform: translateX(0);
    }
  }

  .dock-anim {
    animation: dock-enter 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .dock-icon {
    transition: transform 0.15s ease-out, margin 0.15s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-anim {
      animation: none;
    }
    .dock-icon {
      transition: none;
    }
  }
</style>

<script>
  const dock = document.getElementById('dock');
  const icons = Array.from(document.querySelectorAll<HTMLAnchorElement>('.dock-icon'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dock && icons.length && !prefersReducedMotion) {
    const iconSize = 48; // matches w-12/h-12
    const maxDistance = 80;
    const maxScale = 0.4;
    const maxPop = 8;

    dock.addEventListener('mousemove', (e) => {
      const mouseY = e.clientY;
      icons.forEach((icon) => {
        const rect = icon.getBoundingClientRect();
        const iconCenter = rect.top + rect.height / 2;
        const distance = Math.abs(mouseY - iconCenter);
        const strength = Math.max(0, 1 - distance / maxDistance);
        const scale = 1 + strength * maxScale;
        // Grow the icon's own box via margin so neighbors get pushed away
        // instead of being covered by the scaled-up icon.
        const extraMargin = ((scale - 1) * iconSize) / 2;
        const pop = strength * maxPop;
        icon.style.marginTop = `${extraMargin}px`;
        icon.style.marginBottom = `${extraMargin}px`;
        icon.style.transform = `translateX(-${pop}px) scale(${scale})`;
      });
    });

    dock.addEventListener('mouseleave', () => {
      icons.forEach((icon) => {
        icon.style.marginTop = '';
        icon.style.marginBottom = '';
        icon.style.transform = '';
      });
    });
  }
</script>
